# .env.example
# Copy this file to .env and fill in the values
# .env is never committed to git - .env.example is
# This file sits at the root of glaucoma-detection/ alongside docker-compose.yml

# PostgreSQL password
# Must match the password in backend/.env DATABASE_URL
POSTGRES_PASSWORD=your_postgres_password_here

# Frontend API URL
# Where the browser makes API calls - must be externally accessible
# Local Docker Compose: http://localhost:8000
# EC2 deployment: http://<ec2-public-ip>:8000
VITE_API_URL=http://localhost:8000
