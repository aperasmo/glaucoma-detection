# ============================================
# Terraform
# ============================================
# Local provider plugin cache - large, machine-specific, and fully
# reproducible from .terraform.lock.hcl + terraform init. Never commit.
**/.terraform/

# Variable files often contain real subscription/resource values and
# sometimes secrets (e.g. a client_secret for a service principal).
# .tfvars.example (if ever created) is the safe, committed template.
*.tfvars
*.tfvars.json

# Crash log Terraform writes if it hits an internal error
crash.log
crash.*.log

# Note: .terraform.lock.hcl is INTENTIONALLY NOT ignored - it should be
# committed so everyone/every session gets the exact same provider version.
